# Copy to .env (git-ignored). The AI reader (Jev) is required: estimates of new briefs need at least one key.
# Any number of keys form a pool; an empty key is skipped automatically.
JEVSTATION_API_KEY=
JEVSTATION_API_KEY_2=
# Alternatives: TYPESAFE_API_KEY= (official API) or AI_GATEWAY_API_KEY= (Vercel AI Gateway)
# Optional limits
# JEV_MAX_CALLS_PER_HOUR=120
# JEV_MIN_CREDITS=0
# PARALLAX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# TRUST_PROXY_HEADERS=1  # only behind a proxy that appends X-Forwarded-For
